PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/newsplatform
JWT_SECRET=change-me-to-a-long-random-string

# AWS S3 (image uploads) — see AWS_S3_SETUP.md for how to get these.
# Leave unset and the /uploads endpoint responds 503 without breaking the rest of the app.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional — defaults to https://<bucket>.s3.<region>.amazonaws.com if unset
# (set this if you put a CDN/CloudFront domain in front of the bucket)
AWS_S3_PUBLIC_URL=
