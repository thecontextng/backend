{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "migrate": "node-pg-migrate -r dotenv/config",
    "migrate:up": "node-pg-migrate -r dotenv/config up",
    "migrate:down": "node-pg-migrate -r dotenv/config down",
    "migrate:create": "node-pg-migrate -r dotenv/config create -j cjs",
    "seed": "tsx src/seed.ts",
    "seed:articles": "tsx src/seed-articles.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:suspicious": "node scripts/check-suspicious.cjs",
    "ci:check": "npm run typecheck && npm run lint && npm run check:suspicious",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@vendia/serverless-express": "^4.12.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.13.1",
    "sanitize-html": "^2.17.7"
  },
  "overrides": {
    "htmlparser2": "^8.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  }
}
